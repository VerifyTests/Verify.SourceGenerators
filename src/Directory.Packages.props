    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Polyfill" Version="11.4.3" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.184" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="Verify" Version="33.3.1" />
    <PackageVersion Include="Verify.XunitV3" Version="33.3.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Argon" Version="0.38.0" />
    <PackageVersion Include="DiffEngine" Version="20.7.0" />
    <PackageVersion Include="EmptyFiles" Version="8.20.0" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.0" />
  </ItemGroup>
